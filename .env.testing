# Loaded instead of .env when APP_ENV=testing, which phpunit.xml sets.
# Self-contained: Laravel loads this file *or* .env, never both.

APP_NAME=Laravel
APP_ENV=testing
APP_KEY=base64:vX2jM9USbSKgjwVza92plMwcjbTPnl1BwJq6qvxPXec=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# Cheapest hash the driver allows — tests create users, they don't secure them.
BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# In-memory SQLite: fresh per test process, and never touches uptime_monitor.
DB_CONNECTION=sqlite
DB_DATABASE=:memory:
DB_FOREIGN_KEYS=true

# Nothing here may reach a real service. sync runs jobs inline so tests can
# assert on their effects without a worker; array/null keep the rest in memory.
QUEUE_CONNECTION=sync
CACHE_STORE=array
SESSION_DRIVER=array
BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local
MAIL_MAILER=array

MAIL_FROM_ADDRESS="do-not-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

MONITOR_TIMEOUT=10
MONITOR_BATCH_SIZE=25
